{
  "expo": {
    "name": "Caderno de Bolso",
    "slug": "caderno-de-bolso",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cadernodebolso",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5EFE3",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR"
      }
    },
    "android": {
      "package": "br.edu.ifba.irece.cadernodebolso",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#2F5D34",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Caderno de Bolso usa suas fotos para guardar páginas do caderno de campo e fotos das anotações.",
          "cameraPermission": "O Caderno de Bolso usa a câmera para fotografar as páginas do caderno de campo e as anotações.",
          "microphonePermission": "O Caderno de Bolso usa o microfone para gravar recados de voz nas suas anotações."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Caderno de Bolso usa o microfone para gravar recados de voz nas suas anotações.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Caderno de Bolso usa a câmera para ler o código que liga outro celular ao seu caderno e para fotografar as anotações.",
          "microphonePermission": "O Caderno de Bolso usa o microfone para gravar recados de voz nas suas anotações.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
